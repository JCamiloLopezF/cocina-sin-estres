# Copia este archivo como .env.local y completa los valores. Nunca subas el .env.local.

# URL del backend, terminada en /api
VITE_API_URL=http://localhost:8080/api

# Cómo se entra a la aplicación:
#   firebase  correo y contraseña con Firebase Auth (desarrollo en la nube y producción)
#   dev       sin Firebase: escribes un nombre de prueba y se manda como X-Dev-User.
#             Solo funciona contra el backend con el perfil dev (ADR-19).
VITE_AUTH_MODO=firebase

# Configuración web de Firebase (consola de Firebase → Configuración del proyecto → Tus apps).
# No es secreta: termina en el navegador de cualquier usuaria. Igual va por variables
# para separar los proyectos de desarrollo y producción.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
