# Copia este archivo como .env y completa los valores. Nunca subas el .env.

# Perfil de Spring: dev | prod
SPRING_PROFILES_ACTIVE=dev

# Base de datos (MySQL local del docker-compose.yml de la raíz)
# Para usar estos valores en el compose: docker compose --env-file backend/.env up -d mysql
DB_URL=jdbc:mysql://localhost:3306/cocina_sin_estres?useUnicode=true&characterEncoding=utf8&connectionTimeZone=UTC
DB_USUARIO=cocina
DB_CONTRASENA=
DB_ROOT_CONTRASENA=
# En la nube (perfil prod) la URL apunta a Amazon RDS; los valores reales están en los
# secretos de GitHub de cada ambiente (docs/despliegue/base-de-datos.md):
# DB_URL=jdbc:mysql://<instancia>.<id>.us-east-1.rds.amazonaws.com:3306/<base>?useUnicode=true&characterEncoding=utf8&connectionTimeZone=UTC&sslMode=REQUIRED

# Puerto en el que escucha la API
PUERTO=8080

# Nivel de log de la aplicación: TRACE | DEBUG | INFO | WARN | ERROR
# Por defecto DEBUG en el perfil dev e INFO en prod.
LOG_NIVEL=DEBUG

# Firebase Admin SDK: ruta al JSON de la cuenta de servicio (fuera del repositorio).
# Obligatoria en el perfil prod: sin ella la aplicación no arranca.
# En el perfil dev se deja vacía y se entra con el encabezado X-Dev-User.
FIREBASE_CREDENCIALES_RUTA=

# Clave AES-256 en Base64 para cifrar datos de salud (ADR-20).
# En dev puede quedar vacía (se usa una clave de desarrollo). En prod es obligatoria:
# genérala con  openssl rand -base64 32  y guárdala como secreto, nunca en el repositorio.
CIFRADO_CLAVE_V1=

# Correo de la primera cuenta ADMIN (ADR-16). Solo recibe el rol si Firebase ya
# verificó ese correo y todavía no hay ningún ADMIN.
ADMIN_INICIAL_CORREO=

# Orígenes permitidos por CORS, separados por coma
CORS_ORIGENES=http://localhost:5173

# Límite de peticiones por minuto por cuenta. Opcionales: déjalas comentadas para usar
# los valores por defecto. Con 0 se apaga el límite; si quedan vacías, la API no arranca.
# En prod: 240 en general y 20 para generar/ajustar el plan, otra opción, rescate y análisis.
# En dev están apagados.
# LIMITE_PETICIONES_POR_MINUTO=240
# LIMITE_COSTOSAS_POR_MINUTO=20
