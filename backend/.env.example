# Copia este archivo como .env y completa los valores. Nunca subas el .env.

# Perfil de Spring: dev | prod
SPRING_PROFILES_ACTIVE=dev

# Base de datos (MySQL local del docker-compose.yml de la raíz)
# Para usar estos valores en el compose: docker compose --env-file backend/.env up -d mysql
DB_URL=jdbc:mysql://localhost:3306/cocina_sin_estres?useUnicode=true&characterEncoding=utf8&connectionTimeZone=UTC
DB_USUARIO=cocina
DB_CONTRASENA=
DB_ROOT_CONTRASENA=

# Firebase Admin SDK: ruta al JSON de la cuenta de servicio (fuera del repositorio)
FIREBASE_CREDENCIALES_RUTA=

# Clave AES-256 en Base64 para cifrar datos de salud (ADR-20)
CIFRADO_CLAVE_V1=

# Correo de la primera cuenta ADMIN (ADR-16)
ADMIN_INICIAL_CORREO=

# Orígenes permitidos por CORS, separados por coma
CORS_ORIGENES=http://localhost:5173
